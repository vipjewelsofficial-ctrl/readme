{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign eyebrow = section.settings.eyebrow
  assign card_style = section.settings.card_style
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
-%}

<section
  class="collection-card-section section"
  id="collection-card-grid-{{ section.id }}"
  style="--ccg-bg: {{ section.settings.background_color }}; --ccg-text: {{ section.settings.text_color }}; --ccg-accent: {{ section.settings.accent_color }}; --ccg-card-bg: {{ section.settings.card_background }}; --ccg-columns: {{ columns_desktop }}; --ccg-mobile-columns: {{ columns_mobile }}; --section-bg: {{ section.settings.background_color }}; --section-text: {{ section.settings.text_color }}; --section-accent: {{ section.settings.accent_color }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  {% if heading != blank %}aria-labelledby="ccg-heading-{{ section.id }}"{% else %}aria-label="Shop collections"{% endif %}
>
  <div class="container">
    {%- if eyebrow != blank or heading != blank or subheading != blank -%}
      <div class="section-header collection-card-section__header">
        {%- if eyebrow != blank -%}<p class="section-eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
        {%- if heading != blank -%}<h2 class="section-title" id="ccg-heading-{{ section.id }}">{{ heading | escape }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<p class="collection-card-section__subheading">{{ subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-card-grid collection-card-grid--{{ card_style }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection
          assign card_product = block.settings.product
          assign card_image = block.settings.image
          if card_image == blank and card_product != blank
            assign card_image = card_product.featured_image
          endif
          if card_image == blank and section.settings.use_collection_images and card_collection != blank
            assign card_image = card_collection.featured_image
          endif
          assign card_title = block.settings.title
          if card_title == blank and card_product != blank
            assign card_title = card_product.title
          endif
          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          endif
          assign card_url = block.settings.link
          if card_url == blank and card_product != blank
            assign card_url = card_product.url
          endif
          if card_url == blank and card_collection != blank
            assign card_url = card_collection.url
          endif
          if card_url == blank
            assign card_url = routes.all_products_collection_url
          endif
        -%}
        <article class="collection-card" role="listitem" {{ block.shopify_attributes }}>
          <a class="collection-card__link" href="{{ card_url }}">
            <div class="collection-card__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'collection-card__image',
                    loading: 'lazy',
                    widths: '240, 360, 540, 720, 900',
                    sizes: '(max-width: 749px) 46vw, (max-width: 1199px) 30vw, 220px',
                    alt: card_title
                }}
              {%- elsif section.settings.show_demo_images and card_product == blank -%}
                {%- liquid
                  assign demo_occ_index = forloop.index0 | modulo: 4 | plus: 1
                  assign demo_occ_asset = 'demo-style-' | append: demo_occ_index | append: '.jpg'
                -%}
                <img
                  class="collection-card__image"
                  src="{{ demo_occ_asset | asset_url }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="900"
                  height="1125"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card__image' }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="collection-card__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
            </div>
            <div class="collection-card__content">
              {%- if card_title != blank -%}<h3 class="collection-card__title">{{ card_title | escape }}</h3>{%- endif -%}
              {%- if section.settings.show_descriptions and block.settings.description != blank -%}
                <p class="collection-card__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="section-cta">
        <a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Style",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by occasion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Occasion"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find jewellery for weddings, celebrations, everyday styling and parties."
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card image shape",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "use_collection_images",
      "label": "Use collection images when no custom image is selected",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_demo_images",
      "label": "Show sample images on unassigned cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_descriptions",
      "label": "Show card descriptions",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bottom button label",
      "default": "View All Jewellery"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Bottom button link"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F7F2EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#7A1F32"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Style card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product (optional)",
          "info": "Links this card to the chosen product and uses its image when no custom image is selected. Leave blank to link to the collection."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Oxidised Jewellery"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Style it your way"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Style",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Oxidised"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Traditional"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Statement"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Everyday"
          }
        }
      ]
    }
  ]
}
{% endschema %}
