{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'ProductForm-' | append: section.id
-%}

{{ 'product-mobile-details.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-mobile-details.js' | asset_url }}" defer></script>

<section style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;" class="section main-product-section main-product-section--gallery-{{ section.settings.gallery_position }} main-product-section--mobile-gallery-{{ section.settings.mobile_gallery_position }}{% if section.settings.enable_mobile_details and section.settings.mobile_sticky_cart %} main-product-section--sticky-cart{% endif %}">
  <div class="page-shell">
    <div class="product-layout">
      <div class="product-gallery">
        <div class="product-gallery__stage">
          {%- if featured_media != blank -%}
            {%- liquid
              assign featured_image = featured_media.preview_image
              assign featured_image_alt = featured_image.alt | default: product.title
            -%}
            {{
              featured_image
              | image_url: width: 1200
              | image_tag:
                class: 'product-gallery__main',
                id: 'ProductMainImage',
                alt: featured_image_alt,
                loading: 'eager',
                fetchpriority: 'high',
                widths: '480, 720, 960, 1200',
                sizes: '(max-width: 989px) 100vw, 55vw'
            }}
          {%- else -%}
            <div class="product-gallery__placeholder">{{ 'products.product.no_image' | t }}</div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs" aria-label="{{ 'accessibility.product_images' | t }}">
            {%- for media in product.media -%}
              {%- liquid
                assign thumbnail = media.preview_image
                assign thumbnail_alt = thumbnail.alt | default: product.title
              -%}
              <button
                class="product-gallery__thumb{% if media.id == featured_media.id %} is-active{% endif %}"
                type="button"
                data-product-thumbnail
                data-full-src="{{ thumbnail | image_url: width: 1200 }}"
                data-alt="{{ thumbnail.alt | default: product.title | escape }}"
                aria-label="{{ 'accessibility.view_image' | t: number: forloop.index, count: product.media.size }}"
                aria-pressed="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
              >
                {{
                  thumbnail
                  | image_url: width: 180
                  | image_tag:
                    alt: thumbnail_alt,
                    loading: 'lazy',
                    width: 90,
                    height: 90
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info-wrap">
{% capture component_vendor %}
        {%- if product.vendor != blank -%}
          <p class="product-info__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}

{% endcapture %}
{% capture component_title %}
        <h1 class="product-info__title">{{ product.title | escape }}</h1>

{% endcapture %}
{% capture component_price %}
        <div class="product-detail-price" data-product-price aria-live="polite">
          {% render 'price', product: product, variant: current_variant %}
        </div>

{% endcapture %}
{% capture component_description %}
        {%- if product.description != blank and section.settings.enable_mobile_details != true or product.description != blank and section.settings.description_display == 'plain' -%}
          <div class="product-info__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

{% endcapture %}
{% capture component_buy_buttons %}
        {%- form 'product', product, id: product_form_id, class: 'product-form' -%}
          {%- if product.variants.size > 1 -%}
            <div class="product-form__field">
              <label class="product-form__label" for="Variant-{{ section.id }}">{{ 'products.product.choose_option' | t }}</label>
              <select class="product-form__select" id="Variant-{{ section.id }}" name="id" data-variant-select>
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign variant_savings = 0
                    if variant.compare_at_price > variant.price
                      assign variant_savings = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
                    endif
                  -%}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money | escape }}"
                    data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                    data-savings="{{ variant_savings }}"
                    data-available="{{ variant.available }}"
                    data-image-src="{% if variant.featured_media != blank %}{{ variant.featured_media.preview_image | image_url: width: 1200 }}{% endif %}"
                    {% if variant.id == current_variant.id %}selected{% endif %}
                  >
                    {{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endif -%}

{% if section.settings.show_quantity != false %}          <div class="product-form__field">
            <label class="product-form__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
            <input class="product-form__quantity" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric">
          </div>{% else %}<input type="hidden" name="quantity" value="1">{% endif %}

          <button
            type="submit"
            name="add"
            class="btn btn--primary product-form__submit"
            data-product-submit
            {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}

{% endcapture %}
{% capture component_details %}
        {%- if section.settings.enable_mobile_details -%}
          {% render 'product-mobile-details', product: product, section: section %}
          {%- if section.settings.mobile_sticky_cart -%}
            <div class="product-mobile-sticky-cart" data-mobile-sticky-cart data-product-form-id="{{ product_form_id }}" hidden>
              <button type="submit" name="add" form="{{ product_form_id }}" class="btn btn--primary product-mobile-sticky-cart__button"{% unless current_variant.available %} disabled aria-disabled="true"{% endunless %}>
                {% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
              </button>
            </div>
          {%- endif -%}
        {%- endif -%}

{% endcapture %}
{% capture component_trust %}
        {%- unless section.settings.enable_mobile_details -%}
        <div class="product-trust" aria-label="{{ 'sections.product_details.benefits' | t }}">
          <span class="product-trust__item">{{ section.settings.trust_1 | escape }}</span>
          <span class="product-trust__item">{{ section.settings.trust_2 | escape }}</span>
          <span class="product-trust__item">{{ section.settings.trust_3 | escape }}</span>
        </div>
        {%- endunless -%}
{% endcapture %}
{%- liquid
  assign has_component_blocks = section.settings.use_component_blocks
  for block in section.blocks
    case block.type
      when 'vendor', 'title', 'price', 'description', 'buy_buttons', 'details', 'trust', 'wishlist', 'text', '@app'
        assign has_component_blocks = true
    endcase
  endfor
-%}
{% if has_component_blocks %}
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'vendor' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_vendor }}</div>
      {% when 'title' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_title }}</div>
      {% when 'price' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_price }}</div>
      {% when 'description' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_description }}</div>
      {% when 'buy_buttons' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_buy_buttons }}</div>
      {% when 'details' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_details }}</div>
      {% when 'wishlist' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{% render 'wishlist-button', product: product %}</div>
      {% when 'trust' %}<div class="product-editor-block" {{ block.shopify_attributes }}>{{ component_trust }}</div>
      {% when 'text' %}<div class="product-editor-block rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {% when '@app' %}{% render block %}
    {% endcase %}
  {% endfor %}
{% else %}
{{ component_vendor }}
{{ component_title }}
{{ component_price }}
{{ component_description }}
{{ component_buy_buttons }}
{% render 'wishlist-button', product: product %}
{{ component_details }}
{{ component_trust }}
{% endif %}
      </div>
    </div>
  </div>
</section>

