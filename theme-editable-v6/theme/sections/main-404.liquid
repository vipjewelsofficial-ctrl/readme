<section class="section main-404-section" style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-shell page-shell--narrow">
    <span class="main-404__code" aria-hidden="true">404</span>
    <h1 class="page-title">{{ section.settings.heading | escape }}</h1>
    <p class="main-404__text">{{ section.settings.message | escape }}</p>
    <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This piece is no longer here"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "The page may have moved, but there is plenty more jewellery to discover."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Return to Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    }
  ]
}
{% endschema %}
