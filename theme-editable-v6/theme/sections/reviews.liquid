{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="reviews section section--peach-soft" id="reviews-{{ section.id }}" style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;" {% if section.settings.heading != blank %}aria-labelledby="reviews-heading-{{ section.id }}"{% else %}aria-label="Customer reviews"{% endif %}>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header">
        {%- if section.settings.subheading != blank -%}
          <p class="section-eyebrow">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="reviews-heading-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="reviews-grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <article class="review-card" role="listitem" {{ block.shopify_attributes }}>
            <!-- Stars -->
            <div class="review-card__stars" aria-label="{{ rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="review-card__star{% if i > rating %} review-card__star--empty{% endif %}" aria-hidden="true">★</span>
              {%- endfor -%}
            </div>
            <!-- Review text -->
            <blockquote class="review-card__text">
              <p>"{{ block.settings.text | escape }}"</p>
            </blockquote>
            <!-- Author -->
            <footer class="review-card__footer">
              <span class="review-card__author">{{ block.settings.author | escape }}</span>
              {%- if block.settings.location != blank -%}
                <span class="review-card__location">{{ block.settings.location | escape }}</span>
              {%- endif -%}
              {%- if block.settings.product != blank -%}
                <span class="review-card__product">{{ block.settings.product | escape }}</span>
              {%- endif -%}
            </footer>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="section-empty-message">Add genuine customer reviews to display this section on your live store.</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews / Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Loved, styled and shared by our community"
    },
    {
      "type": "header",
      "content": "Section design"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Heading / text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent / eyebrow colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 9,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Rating (stars)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Add a genuine customer review here."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location (optional)",
          "default": "Customer location"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product name (optional)",
          "default": "Purchased product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews / Testimonials"
    }
  ]
}
{% endschema %}
