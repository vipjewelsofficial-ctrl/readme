  {
    "name": "Layout & typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "cormorant_garamond_n6"
      },
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Page width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "section_spacing_desktop",
        "min": 40,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Desktop section spacing",
        "default": 80
      },
      {
        "type": "range",
        "id": "section_spacing_mobile",
        "min": 24,
        "max": 80,
        "step": 4,
        "unit": "px",
        "label": "Mobile section spacing",
        "default": 48
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px",
        "label": "Body font size",
        "default": 16
      },
      {
        "type": "range",
        "id": "section_heading_size",
        "min": 24,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Section heading size",
        "default": 38
      },
      {
        "type": "range",
        "id": "product_title_font_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Product title size",
        "default": 16
      },
      {
        "type": "range",
        "id": "product_price_font_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Product price size",
        "default": 15
      },
      {
        "type": "range",
        "id": "button_font_size",
        "min": 10,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Button font size",
        "default": 13
      },
      {
        "type": "select",
        "id": "section_heading_alignment",
        "label": "Section heading alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "select",
        "id": "button_text_transform",
        "label": "Button text style",
        "default": "uppercase",
        "options": [
          {
            "value": "none",
            "label": "Normal"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ]
      }
    ]
  },
  {
    "name": "Cards & buttons",
    "settings": [
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Card radius",
        "default": 2
      },
      {
        "type": "range",
        "id": "image_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Image radius",
        "default": 2
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Button radius",
        "default": 2
      },
      {
        "type": "range",
        "id": "card_shadow_opacity",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "%",
        "label": "Card shadow opacity",
        "default": 0
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show quick add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_sale_badge",
        "label": "Show sale badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_sold_badge",
        "label": "Show sold-out badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_savings",
        "label": "Show percentage savings",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_compare_price",
        "label": "Show compare-at prices",
        "default": true
      }
    ]
  },
  {
    "name": "Wishlist",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_wishlist",
        "label": "Enable browser-saved wishlist",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "wishlist_on_cards",
        "label": "Show hearts on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "wishlist_in_header",
        "label": "Show wishlist in header",
        "default": true
      },
      {
        "type": "text",
        "id": "wishlist_heading",
        "label": "Wishlist heading",
        "default": "Your Wishlist"
      },
      {
        "type": "text",
        "id": "wishlist_empty_text",
        "label": "Empty wishlist message",
        "default": "Save your favourite jewellery here."
      },
      {
        "type": "paragraph",
        "content": "Saved in this browser without an app or account. It does not sync across devices. Removing browser data clears saved items. View product opens the current product page for price, options and availability."
      }
    ]
  }
]
