{{ 'hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-slider.js' | asset_url }}" defer></script>
{%- liquid
  assign slide_count = section.blocks.size
  assign include_base = section.settings.include_base
  if include_base != false or slide_count == 0
    assign include_base = true
    assign slide_count = slide_count | plus: 1
  endif
  assign block_count = section.blocks.size
  assign slide_position = 0
-%}
<div class="hero-slider" id="hero-{{ section.id }}" data-hero-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.slide_interval | times: 1000 }}" data-pause-label="{{ 'sections.slider.pause' | t }}" data-play-label="{{ 'sections.slider.play' | t }}" role="region" aria-roledescription="{{ 'sections.slider.slideshow' | t }}" aria-label="{{ section.settings.heading | default: shop.name | escape }}">
  {%- for slide_index in (0..block_count) -%}
    {%- if slide_index == 0 -%}
      {%- if include_base -%}
        {% render 'hero-slide', slide: section.settings, section: section, position: slide_position, total: slide_count, block_id: 'base' %}
        {%- assign slide_position = slide_position | plus: 1 -%}
      {%- endif -%}
    {%- else -%}
      {%- assign block_index = slide_index | minus: 1 -%}
      {%- assign block = section.blocks[block_index] -%}
      {% render 'hero-slide', slide: block.settings, section: section, position: slide_position, total: slide_count, block_id: block.id, block_attributes: block.shopify_attributes %}
      {%- assign slide_position = slide_position | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if slide_count > 1 -%}
    <div class="hero-slider__controls">
      {% if section.settings.show_arrows %}<button type="button" data-slider-prev aria-label="{{ 'sections.slider.previous' | t }}">←</button>{% endif %}
      {% if section.settings.show_dots %}<div class="hero-slider__dots">{% for index in (1..slide_count) %}<button type="button" data-slide-index="{{ index | minus: 1 }}" aria-label="{{ 'sections.slider.go_to' | t: number: index }}" aria-current="{% if index == 1 %}true{% else %}false{% endif %}"></button>{% endfor %}</div>{% endif %}
      {% if section.settings.show_arrows %}<button type="button" data-slider-next aria-label="{{ 'sections.slider.next' | t }}">→</button>{% endif %}
      {% if section.settings.autoplay %}<button type="button" data-slider-pause aria-pressed="false">{{ 'sections.slider.pause' | t }}</button>{% endif %}
    </div>
    <span class="visually-hidden" data-slider-status aria-live="polite" aria-atomic="true">1 / {{ slide_count }}</span>
  {%- endif -%}
</div>

