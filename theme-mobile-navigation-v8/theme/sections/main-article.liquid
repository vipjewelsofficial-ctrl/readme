<article class="section" style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"><div class="page-shell"><header class="page-header"><p class="page-eyebrow">{{ blog.title | escape }}</p><h1 class="page-title">{{ article.title | escape }}</h1></header>{% if article.image and section.settings.show_image != false %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.title }}{% endif %}{% if section.settings.show_date %}<p>{{ article.published_at | date: '%d %B %Y' }}</p>{% endif %}{% if section.settings.show_author %}<p>{{ article.author | escape }}</p>{% endif %}<div class="rte">{{ article.content }}</div>{% if section.settings.show_back_link != false %}<p><a class="article-back" href="{{ blog.url }}">{{ section.settings.back_label | escape }} {{ blog.title | escape }}</a></p>{% endif %}</div></article>

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show article image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publication date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show link back to blog",
      "default": true
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "← Back to"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    }
  ]
}
{% endschema %}
