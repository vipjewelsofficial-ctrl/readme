<section class="section main-page-section" style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-shell{% if section.settings.content_width == 'narrow' %} page-shell--narrow{% endif %}">
    {% if section.settings.show_title != false %}<header class="page-header">
      <h1 class="page-title">{{ page.title | escape }}</h1>
    </header>{% endif %}
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Page",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    }
  ]
}
{% endschema %}
