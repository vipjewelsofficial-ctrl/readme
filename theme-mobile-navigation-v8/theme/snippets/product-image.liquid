{%- comment -%}
  Renders a responsive product image using Shopify image_url filter.
  Accepts:
    - image: {Object} Shopify image object (required)
    - alt: {String} Alt text (optional)
    - width: {Number} Base width (optional)
    - height: {Number} Base height (optional)
    - class: {String} Additional CSS classes (optional)
    - lazy: {Boolean} Whether to lazy load (default: true)
{%- endcomment -%}

{%- liquid
  assign img_alt = alt | default: image.alt | escape
  assign img_class = class | default: ''
  assign is_lazy = lazy | default: true
-%}

{%- if image != blank -%}
  {%- if is_lazy -%}
    {{
      image
      | image_url: width: 800
      | image_tag:
        class: img_class,
        alt: img_alt,
        loading: 'lazy',
        widths: '200, 300, 400, 600, 800, 1000',
        sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw'
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 800
      | image_tag:
        class: img_class,
        alt: img_alt,
        loading: 'eager',
        fetchpriority: 'high',
        widths: '200, 300, 400, 600, 800, 1000',
        sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw'
    }}
  {%- endif -%}
{%- else -%}
  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
