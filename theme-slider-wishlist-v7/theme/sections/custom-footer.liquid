{%- liquid
  assign footer_menu_1 = section.settings.footer_menu_1
  assign footer_menu_2 = section.settings.footer_menu_2
  assign footer_menu_3 = section.settings.footer_menu_3
  assign newsletter_heading = section.settings.newsletter_heading
  assign footer_description = section.settings.footer_description
  assign show_payment_icons = section.settings.show_payment_icons
  assign newsletter_form_id = 'FooterNewsletter-' | append: section.id
  assign newsletter_input_id = 'FooterEmail-' | append: section.id
-%}

<footer class="site-footer" role="contentinfo" id="site-footer-{{ section.id }}">
  <div class="footer-inner">
    <!-- Top footer: logo + menus + newsletter -->
    <div class="footer-top">

      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="footer-brand__logo" aria-label="{{ shop.name | escape }} home">
          <img class="footer-brand__logo-image" src="{{ 'gujjujewels-logo-footer.png' | asset_url }}" width="1100" height="778" loading="lazy" decoding="async" alt="Gujju Jewels">
        </a>
        {%- if footer_description != blank -%}
          <p class="footer-brand__desc">{{ footer_description | escape }}</p>
        {%- endif -%}
        <!-- Social Links -->
        <div class="footer-social">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="footer-social__link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="2"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="2"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="footer-social__link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_whatsapp != blank -%}
            <a href="https://wa.me/{{ section.settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" class="footer-social__link" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" class="footer-social__link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z" stroke="currentColor" stroke-width="2"/>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Menu Columns -->
      {%- if footer_menu_1 != blank -%}
        <nav class="footer-nav" aria-label="{{ footer_menu_1.title | escape }}">
          <h3 class="footer-nav__title">{{ footer_menu_1.title | escape }}</h3>
          <ul class="footer-nav__list" role="list">
            {%- for link in footer_menu_1.links -%}
              <li><a href="{{ link.url }}" class="footer-nav__link">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if footer_menu_2 != blank -%}
        <nav class="footer-nav" aria-label="{{ footer_menu_2.title | escape }}">
          <h3 class="footer-nav__title">{{ footer_menu_2.title | escape }}</h3>
          <ul class="footer-nav__list" role="list">
            {%- for link in footer_menu_2.links -%}
              <li><a href="{{ link.url }}" class="footer-nav__link">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if footer_menu_3 != blank -%}
        <nav class="footer-nav" aria-label="{{ footer_menu_3.title | escape }}">
          <h3 class="footer-nav__title">{{ footer_menu_3.title | escape }}</h3>
          <ul class="footer-nav__list" role="list">
            {%- for link in footer_menu_3.links -%}
              <li><a href="{{ link.url }}" class="footer-nav__link">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <!-- Newsletter -->
      <div class="footer-newsletter">
        {%- if newsletter_heading != blank -%}
          <h3 class="footer-nav__title">{{ newsletter_heading | escape }}</h3>
        {%- endif -%}
        <p class="footer-newsletter__desc">{{ section.settings.newsletter_description | escape }}</p>
        {%- form 'customer', id: newsletter_form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-newsletter__form">
            <label for="{{ newsletter_input_id }}" class="visually-hidden">Email address</label>
            <input
              type="email"
              name="contact[email]"
              id="{{ newsletter_input_id }}"
              class="footer-newsletter__input"
              placeholder="{{ 'general.newsletter_form.email_placeholder' | t | default: 'Your email address' }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="footer-newsletter__btn btn btn--primary" aria-label="Subscribe to newsletter">
              Subscribe
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="footer-newsletter__success" role="status">Thank you for subscribing.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p class="footer-bottom__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.
      </p>

      <!-- Policy Links (dynamic from Shopify) -->
      <nav class="footer-policies" aria-label="Legal">
        {%- if shop.privacy_policy != blank -%}
          <a href="{{ shop.privacy_policy.url }}" class="footer-policy-link">Privacy Policy</a>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <a href="{{ shop.terms_of_service.url }}" class="footer-policy-link">Terms of Service</a>
        {%- endif -%}
        {%- if shop.refund_policy != blank -%}
          <a href="{{ shop.refund_policy.url }}" class="footer-policy-link">Refund Policy</a>
        {%- endif -%}
        {%- if shop.shipping_policy != blank -%}
          <a href="{{ shop.shipping_policy.url }}" class="footer-policy-link">Shipping Policy</a>
        {%- endif -%}
      </nav>

      {%- if show_payment_icons -%}
        <div class="footer-payment-icons" aria-label="Accepted payment methods">
          {% render 'icon', icon: 'payment-visa' %}
          {% render 'icon', icon: 'payment-mastercard' %}
          {% render 'icon', icon: 'payment-upi' %}
          {% render 'icon', icon: 'payment-cod' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Legacy Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Brand Description",
      "default": "Gujju Jewels brings heritage-inspired oxidised jewellery to modern wardrobes—distinctive, versatile and made to be styled your way."
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Footer Menu 1",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Footer Menu 2 (Customer Support)"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Footer Menu 3 (About)"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay In The Loop"
    },
    {
      "type": "text",
      "id": "newsletter_description",
      "label": "Newsletter description",
      "default": "New drops, exclusive offers & style tips delivered to your inbox."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "text",
      "id": "social_whatsapp",
      "label": "WhatsApp Number (with country code, e.g. +919876543210)"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Payment Icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "default": true,
      "label": "Show payment icons"
    }
  ],
  "presets": [
    {
      "name": "Legacy Footer"
    }
  ]
}
{% endschema %}
