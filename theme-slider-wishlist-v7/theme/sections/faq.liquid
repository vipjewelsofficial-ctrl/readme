<section class="faq section section--ivory" id="faq-{{ section.id }}" style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;" {% if section.settings.heading != blank %}aria-labelledby="faq-heading-{{ section.id }}"{% else %}aria-label="Frequently asked questions"{% endif %}>
  <div class="container faq-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header">
        {%- if section.settings.subheading != blank -%}
          <p class="section-eyebrow">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="faq-heading-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faq-list">
        {%- for block in section.blocks -%}
          <details {% if block.settings.open %}open{% endif %} class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-item__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq-item__icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="faq-item__answer">
              <p>{{ block.settings.answer | escape }}</p>
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know"
    },
    {
      "type": "header",
      "content": "Section design"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Heading / text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent / eyebrow colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "limit": 15,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is this jewellery made from pure silver?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Unless a product page specifically states 925 sterling silver, our pieces are silver-tone oxidised fashion jewellery."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open this question initially",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Is this jewellery made from pure silver?",
            "answer": "Unless a product page specifically states 925 sterling silver, our pieces are silver-tone oxidised fashion jewellery."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How should I care for oxidised jewellery?",
            "answer": "Keep each piece dry, apply perfume before wearing it, and store it separately in a soft pouch after use."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer Cash on Delivery?",
            "answer": "Yes, COD is available across India. Select COD at checkout."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "Contact us within 7 days of delivery and we will guide you according to the return policy shown on our store."
          }
        }
      ]
    }
  ]
}
{% endschema %}
