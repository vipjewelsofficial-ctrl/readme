<section class="section main-search-section" style="--section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --products-mobile-columns: {{ section.settings.columns_mobile }};">
  <div class="page-shell">
    <header class="page-header">
      <p class="page-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="page-title">{{ section.settings.heading | escape }}</h1>
    </header>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="MainSearchInput">{{ section.settings.heading | escape }}</label>
      <input
        class="search-form__input"
        id="MainSearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="{{ section.settings.result_type }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="btn btn--primary">{{ section.settings.button_label | escape }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- if search.results_count > 0 -%}
          <p class="search-summary">{% if search.results_count == 1 %}{{ 'general.search.one_result' | t: count: search.results_count, terms: search.terms | escape }}{% else %}{{ 'general.search.many_results' | t: count: search.results_count, terms: search.terms | escape }}{% endif %}</p>
          <div class="products-grid products-grid--{{ section.settings.columns_desktop }}-col" role="list">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <div role="listitem">
                  {% render 'product-card', product: item %}
                </div>
              {% else %}<article role="listitem"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncate: 180 }}</p></article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state">
            <p>{{ section.settings.empty_text | escape }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.browse_label | escape }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Search",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Find your next piece"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search Jewellery"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search earrings, necklaces, bangles..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Search button",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "No-results message",
      "default": "No jewellery matched your search. Try a shorter or more general search."
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "Browse button",
      "default": "Browse All Jewellery"
    },
    {
      "type": "select",
      "id": "result_type",
      "label": "Search content",
      "options": [
        {
          "value": "product",
          "label": "Products only"
        },
        {
          "value": "product,page,article",
          "label": "Products, pages and articles"
        }
      ],
      "default": "product"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 48
    }
  ]
}
{% endschema %}
