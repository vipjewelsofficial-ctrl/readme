{% if section.blocks.size > 0 or section.settings.show_demo != false %}
  <section
    class="social-gallery section"
    id="social-gallery-{{ section.id }}"
    style="--social-mobile-columns: {{ section.settings.columns_mobile }}; --social-gallery-bg: {{ section.settings.background_color }}; --social-gallery-text: {{ section.settings.text_color }}; --social-gallery-accent: {{ section.settings.accent_color }}; --section-bg: {{ section.settings.background_color }}; --section-text: {{ section.settings.text_color }}; --section-accent: {{ section.settings.accent_color }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
    {% if section.settings.heading != blank %}aria-labelledby="social-heading-{{ section.id }}"{% else %}aria-label="Customer styling gallery"{% endif %}
  >
    <div class="container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="section-header social-gallery__header">
          {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="section-title" id="social-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="social-gallery__subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="social-gallery__grid" style="--social-gallery-columns: {{ section.settings.columns_desktop }};" role="list">
          {%- for block in section.blocks -%}
            <article class="social-gallery__item" role="listitem" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a class="social-gallery__link" href="{{ block.settings.link }}" {% if section.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %} aria-label="{{ block.settings.caption | default: 'View customer styling post' | escape }}">{%- endif -%}
                <div class="social-gallery__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        class: 'social-gallery__image',
                        loading: 'lazy',
                        widths: '240, 360, 540, 720, 800',
                        sizes: '(max-width: 749px) 50vw, 25vw',
                        alt: block.settings.caption
                    }}
                  {%- elsif section.settings.show_demo != false -%}
                    {%- assign demo_social_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                    {%- assign demo_social_asset = 'demo-social-' | append: demo_social_index | append: '.jpg' -%}
                    <img class="social-gallery__image" src="{{ demo_social_asset | asset_url }}" alt="{{ block.settings.caption | default: 'Gujju Jewels styling inspiration' | escape }}" loading="lazy" width="800" height="800">
                  {%- else -%}{{ 'image' | placeholder_svg_tag: 'social-gallery__placeholder' }}
                  {%- endif -%}
                  <span class="social-gallery__icon" aria-hidden="true">◎</span>
                </div>
                {%- if block.settings.caption != blank -%}<p class="social-gallery__caption">{{ block.settings.caption | escape }}</p>{%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="social-gallery__grid" style="--social-gallery-columns: {{ section.settings.columns_desktop }};" role="list">
          {%- for demo_index in (1..6) -%}
            {%- assign demo_social_asset = 'demo-social-' | append: demo_index | append: '.jpg' -%}
            <article class="social-gallery__item" role="listitem">
              <div class="social-gallery__media">
                <img
                  class="social-gallery__image"
                  src="{{ demo_social_asset | asset_url }}"
                  alt="Gujju Jewels styling inspiration {{ demo_index }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
                <span class="social-gallery__icon" aria-hidden="true">◎</span>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="section-cta">
          <a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.root_url }}"{% if section.settings.open_new_tab %} target="_blank" rel="noopener"{% endif %}>
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>


{% endif %}

{% schema %}
{
  "name": "Social Styling Gallery",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wear it your way"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear It Your Way"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Follow us for jewellery styling inspiration and new looks."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow on Instagram"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Instagram profile link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open Instagram in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#7A1F32"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_demo",
      "label": "Show demo photos when images are missing",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Gallery post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (recommended: square)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Jewellery styling inspiration"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram or product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Styling Gallery",
      "blocks": [
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        }
      ]
    }
  ]
}
{% endschema %}
