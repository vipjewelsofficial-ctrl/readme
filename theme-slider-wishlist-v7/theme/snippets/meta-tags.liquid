{%- liquid
  assign social_title = page_title | default: shop.name
  assign social_description = page_description | default: shop.description | default: shop.name
  assign social_url = canonical_url
  assign social_type = 'website'

  if request.page_type == 'product'
    assign social_type = 'product'
  elsif request.page_type == 'article'
    assign social_type = 'article'
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ social_url | escape }}">
<meta property="og:title" content="{{ social_title | escape }}">
<meta property="og:type" content="{{ social_type }}">
<meta property="og:description" content="{{ social_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ social_title | escape }}">
<meta name="twitter:description" content="{{ social_description | escape }}">
<link rel="canonical" href="{{ canonical_url | escape }}">
