{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign featured_collection = section.settings.collection
  assign product_source = featured_collection
  assign sorted_products = blank
  if section.settings.fallback_to_all_products and product_source == blank
    assign product_source = collections['all']
  elsif section.settings.fallback_to_all_products and product_source.products_count == 0
    assign product_source = collections['all']
  endif
  assign products_to_show = section.settings.products_to_show | default: 8
  if featured_collection == blank and product_source != blank
    assign sorted_products = product_source.products | sort: 'published_at' | reverse
  else
    assign sorted_products = product_source.products
  endif
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign show_view_all = section.settings.show_view_all
  assign section_anchor = section.settings.section_id | default: section.id | handleize
  assign show_section = false
  if product_source != blank and product_source.products_count > 0
    assign show_section = true
  elsif request.design_mode
    assign show_section = true
  endif
-%}

{%- liquid
  assign display_products = product_source.products
  if section.settings.manual_products != blank
    assign display_products = section.settings.manual_products
    assign show_section = true
  elsif section.settings.sort_mode == 'collection' and featured_collection == blank
    assign display_products = sorted_products
  endif
  case section.settings.sort_mode
    when 'newest'
      assign display_products = display_products | sort: 'published_at' | reverse
    when 'price_asc'
      assign display_products = display_products | sort: 'price'
    when 'price_desc'
      assign display_products = display_products | sort: 'price' | reverse
    when 'title'
      assign display_products = display_products | sort: 'title'
  endcase
-%}
{%- if show_section -%}
<section
  class="featured-products section new-arrivals-section"
  id="{{ section_anchor }}" style="--products-mobile-columns: {{ section.settings.columns_mobile }}; --section-bg: {{ section.settings.section_background }}; --section-text: {{ section.settings.section_text }}; --section-accent: {{ section.settings.section_accent }}; --section-mobile-pt: {{ section.settings.padding_top_mobile }}px; --section-mobile-pb: {{ section.settings.padding_bottom_mobile }}px; --section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  {% if heading != blank %}aria-labelledby="fp-heading-{{ section.id }}"{% else %}aria-label="Featured products"{% endif %}
>
  <div class="container">
    {%- if heading != blank or subheading != blank -%}
      <div class="section-header">
        {%- if subheading != blank -%}
          <p class="section-eyebrow">{{ subheading | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="fp-heading-{{ section.id }}" class="section-title">{{ heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if display_products.size > 0 -%}
      <div class="products-grid products-grid--{{ columns_desktop }}-col" role="list">
        {%- for product in display_products limit: products_to_show -%}
          <div role="listitem">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>

      {%- if show_view_all and product_source.products_count > products_to_show -%}
        <div class="section-cta">
          <a href="{{ product_source.url }}" class="btn btn--outline">
            {{ section.settings.view_all_label | escape }} {{ heading | default: 'Products' }}
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%}Fallback: show placeholder cards when no collection selected{%- endcomment -%}
      <div class="products-grid products-grid--{{ columns_desktop }}-col" aria-label="No products loaded yet">
        {%- for i in (1..4) -%}
          <div class="product-card product-card--placeholder">
            <div class="product-card__image-wrap">
              <div class="product-card__image-placeholder">
                {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__placeholder-svg' }}
              </div>
            </div>
            <div class="product-card__info">
              <p class="product-card__title placeholder-text">Sample Product</p>
              <p class="product-card__price placeholder-text">₹999</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <p class="section-empty-message">Select a collection in the Theme Editor to display products here.</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Just in at Gujju Jewels"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "fallback_to_all_products",
      "label": "Show all products if this collection is empty or missing",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View All' button"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section anchor ID (for links)",
      "default": "new-arrivals"
    },
    {
      "type": "header",
      "content": "Section design"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "section_text",
      "label": "Heading / text colour",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "section_accent",
      "label": "Accent / eyebrow colour",
      "default": "#7A1F32"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "product_list",
      "id": "manual_products",
      "label": "Choose individual products (optional)",
      "limit": 16
    },
    {
      "type": "select",
      "id": "sort_mode",
      "label": "Product order",
      "options": [
        {
          "value": "collection",
          "label": "Selected collection / selected products"
        },
        {
          "value": "newest",
          "label": "Newest published first"
        },
        {
          "value": "price_asc",
          "label": "Price: low to high"
        },
        {
          "value": "price_desc",
          "label": "Price: high to low"
        },
        {
          "value": "title",
          "label": "Title: A to Z"
        }
      ],
      "default": "collection"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All button label",
      "default": "View All"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 140,
      "step": 2,
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
